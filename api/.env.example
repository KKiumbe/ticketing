# --- App ---
NODE_ENV=development
PORT=4000
# Public URL of this API (Safaricom sends callbacks here, must be HTTPS in production)
API_PUBLIC_URL=https://api.tickets.sikika-ke.co.ke
# Public URL of the Next.js site (ticket & order links point here)
WEB_BASE_URL=https://tickets.sikika-ke.co.ke
# Comma-separated; empty = allow all (the web proxies via rewrites, the mobile app is not a browser)
CORS_ORIGINS=
DATABASE_URL=postgresql://tickets:password@localhost:5432/sikika_tickets
DEFAULT_EVENT_SLUG=business-meets-tech
# Unpaid orders release their seat after this many minutes
PENDING_ORDER_TTL_MIN=30

# --- Auth ---
# openssl rand -hex 32
JWT_SECRET=
# Admin web login
ADMIN_PASSWORD=
# PIN you give gate staff for the mobile app (scan + sell at gate, no admin access)
SCANNER_PIN=

# --- M-Pesa (Daraja) ---
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Paybill: your paybill number. Till (Buy Goods): your STORE/head-office number
MPESA_SHORTCODE=174379
# Fill only if you use a Till (Buy Goods). Leave empty for Paybill.
MPESA_TILL_NUMBER=
# Sandbox passkey for 174379 shown; use your production passkey live
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919
# Random string in the callback URLs so only Safaricom can hit them: openssl rand -hex 16
MPESA_CALLBACK_SECRET=
# true = no Safaricom calls; complete payments via POST /api/v1/pay/simulate/:checkoutId (dev only!)
MPESA_SIMULATE=false

# --- Notifications (optional) ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sikika Tickets <tickets@sikika-ke.co.ke>"
# Your WhatsApp/SMS gateway. Receives POST {phone, message, type, ref, links}
NOTIFY_WEBHOOK_URL=
NOTIFY_WEBHOOK_TOKEN=
