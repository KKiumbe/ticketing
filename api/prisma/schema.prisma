// Sikika Tickets v2 schema.
// Table and column names map 1:1 onto the v1 (sikika-tickets) Postgres schema,
// so this API can run against an existing v1 database without moving data.
// Statuses are plain strings (v1 used TEXT + CHECK constraints); see src/lib/types.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Event {
  id                Int      @id @default(autoincrement())
  slug              String   @unique
  name              String
  description       String?
  venue             String?
  startsAt          DateTime @map("starts_at") @db.Timestamptz(6)
  bannerUrl         String?  @map("banner_url")
  isPublished       Boolean  @default(true) @map("is_published")
  /// Gate (at the door) price = category price + this %
  gateMarkupPercent Decimal  @default(20) @map("gate_markup_percent") @db.Decimal(5, 2)
  /// [{ name, type: 'percent'|'fixed', value, perTicket, appliesTo: 'ALL'|'ONLINE'|'GATE' }]
  fees              Json     @default("[]")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  categories TicketCategory[]
  orders     Order[]
  tickets    Ticket[]

  @@map("events")
}

model TicketCategory {
  id                       Int       @id @default(autoincrement())
  eventId                  Int       @map("event_id")
  name                     String
  description              String?
  /// KES, whole shillings
  price                    Int
  capacity                 Int
  earlyBirdPrice           Int?      @map("early_bird_price")
  earlyBirdDiscountPercent Decimal?  @map("early_bird_discount_percent") @db.Decimal(5, 2)
  earlyBirdEndsAt          DateTime? @map("early_bird_ends_at") @db.Timestamptz(6)
  earlyBirdDaysBefore      Int?      @map("early_bird_days_before")
  /// null = unlimited until the end date
  earlyBirdQuota           Int?      @map("early_bird_quota")
  allowInstallments        Boolean   @default(false) @map("allow_installments")
  /// per ticket
  minDeposit               Int       @default(0) @map("min_deposit")
  installmentDeadline      DateTime? @map("installment_deadline") @db.Timestamptz(6)
  salesOpen                Boolean   @default(true) @map("sales_open")
  sortOrder                Int       @default(0) @map("sort_order")
  createdAt                DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orders  Order[]
  tickets Ticket[]

  @@map("ticket_categories")
}

model Order {
  id                Int       @id @default(autoincrement())
  /// Short code, also the M-Pesa account number. TK… online, GT… gate
  ref               String    @unique
  eventId           Int       @map("event_id")
  categoryId        Int       @map("category_id")
  buyerName         String    @map("buyer_name")
  /// 2547XXXXXXXX
  phone             String
  email             String?
  quantity          Int
  unitPrice         Int       @map("unit_price")
  /// tickets only, before fees
  subtotal          Int?
  feesAmount        Int       @default(0) @map("fees_amount")
  feeBreakdown      Json      @default("[]") @map("fee_breakdown")
  totalAmount       Int       @map("total_amount")
  amountPaid        Int       @default(0) @map("amount_paid")
  isEarlyBird       Boolean   @default(false) @map("is_early_bird")
  /// FULL | INSTALLMENT
  paymentPlan       String    @map("payment_plan")
  /// PENDING | PARTIAL | PAID | EXPIRED | CANCELLED
  status            String    @default("PENDING")
  /// ONLINE | GATE
  saleChannel       String    @default("ONLINE") @map("sale_channel")
  gateMarkupPercent Decimal?  @map("gate_markup_percent") @db.Decimal(5, 2)
  soldBy            String?   @map("sold_by")
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  event    Event          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  payments Payment[]
  tickets  Ticket[]

  @@index([eventId, status], map: "orders_event_idx")
  @@index([phone], map: "orders_phone_idx")
  @@map("orders")
}

model Payment {
  id                Int       @id @default(autoincrement())
  /// null = unmatched Paybill payment (wrong account number)
  orderId           Int?      @map("order_id")
  /// what the customer typed as account number (C2B)
  accountRef        String?   @map("account_ref")
  /// STK | C2B | MANUAL
  channel           String
  amount            Int
  phone             String?
  merchantRequestId String?   @map("merchant_request_id")
  checkoutRequestId String?   @unique @map("checkout_request_id")
  mpesaReceipt      String?   @unique @map("mpesa_receipt")
  /// PENDING | SUCCESS | FAILED
  status            String    @default("PENDING")
  resultDesc        String?   @map("result_desc")
  raw               Json?
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt       DateTime? @map("completed_at") @db.Timestamptz(6)

  order Order? @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([orderId], map: "payments_order_idx")
  @@map("payments")
}

/// One row per admitted person. `code` is the unguessable token inside the QR.
model Ticket {
  id          Int       @id @default(autoincrement())
  orderId     Int       @map("order_id")
  eventId     Int       @map("event_id")
  categoryId  Int       @map("category_id")
  code        String    @unique
  /// 1..quantity within the order
  seq         Int
  holderName  String?   @map("holder_name")
  /// VALID | CHECKED_IN | VOID
  status      String    @default("VALID")
  checkedInAt DateTime? @map("checked_in_at") @db.Timestamptz(6)
  checkedInBy String?   @map("checked_in_by")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  order    Order          @relation(fields: [orderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  event    Event          @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  category TicketCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  scans    ScanLog[]

  @@unique([orderId, seq])
  @@map("tickets")
}

model ScanLog {
  id        Int      @id @default(autoincrement())
  code      String?
  ticketId  Int?     @map("ticket_id")
  /// OK | ALREADY_USED | INVALID | VOID | WRONG_EVENT
  result    String
  gate      String?
  scannedAt DateTime @default(now()) @map("scanned_at") @db.Timestamptz(6)

  ticket Ticket? @relation(fields: [ticketId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("scan_log")
}
